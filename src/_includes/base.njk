<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if tag %}#{{ tag }} — {% elseif title and title != "koshelev secrets" %}{{ title }} — {% endif %}koshelev secrets</title>  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
 
  <link rel="icon" href="{{ '/favicon.svg?v=2' | url }}" type="image/svg+xml">
</head>

<body>

{% if not hideHeader %}
  <header>
    <a href="{{ '/' | url }}">koshelev secrets</a>
  </header>
{% endif %}

  <main>
  {{ content | safe }}

  {% if tags %}
    <div class="tags">
      {% for tag in tags %}
        <a class="tag" href="{{ '/tags/' | url }}{{ tag | slugify }}/">#{{ tag }}</a>
      {% endfor %}
    </div>
  {% endif %}
  </main>

</body>
</html>
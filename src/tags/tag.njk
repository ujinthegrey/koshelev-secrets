---
layout: base.njk

pagination:
  data: collections.tagList
  size: 1
  alias: tag

permalink: "tags/{{ tag | slugify }}/"
---

<h1 class="tag-title">#{{ tag }}</h1>

<ul class="recipe-list">
  {% for recipe in collections.secrets %}
    {% if tag in recipe.data.tags %}
      <li>
        <a href="{{ secret.url | url }}">{{ secret.data.title }}</a>
      </li>
    {% endif %}
  {% endfor %}
</ul>